@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container text-center" style="margin-top: 100px; margin-bottom: 100px;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0" style="border-radius: 12px; padding: 40px;">
                <i class="fa-solid fa-triangle-exclamation text-warning" style="font-size: 60px; margin-bottom: 20px;"></i>
                <h1 class="h3 fw-bold mb-3" style="color: var(--text-primary);">Truy cập bị từ chối</h1>
                <p class="text-muted mb-4">
                    Tài khoản của bạn không có đủ quyền để truy cập vào khu vực quản trị.
                    Vui lòng đăng nhập bằng tài khoản Administrator.
                </p>
                <div>
                    <a href="/" class="btn btn-outline-secondary ripple me-2">Quay lại trang chủ</a>
                    <a href="/User/Login" class="btn btn-accent ripple">Đăng nhập tài khoản khác</a>
                </div>
            </div>
        </div>
    </div>
</div>
