@model IEnumerable<FreshMart.Models.Product>

@{
    ViewData["Title"] = "Sản phẩm";
}

<!-- SEARCH & FILTER PANEL -->
<div class="search-panel mb-4 stagger-item">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="fw-bold mb-0" style="color:var(--text-primary);">
            <i class="fa-solid fa-store me-2" style="color:var(--accent);"></i>Sản phẩm
        </h4>
        @if (ViewBag.Keyword != null || ViewBag.SelectedCategoryId != null || ViewBag.MinPrice != null || ViewBag.MaxPrice != null)
        {
            <a href="/Products" class="btn-accent-outline" style="font-size:12px;padding:6px 16px;">
                <i class="fa-solid fa-xmark"></i> Xóa bộ lọc
            </a>
        }
    </div>

    <!-- Debug Info (Optional, helps verify binding) -->
    @if (Context.Request.Query.Count > 0 && !string.IsNullOrEmpty(ViewBag.DebugState))
    {
        <div style="display:none;" id="debugFilter">@ViewBag.DebugState</div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert" style="border-radius:12px; border:none; background:rgba(239, 68, 68, 0.1); color:#ef4444;">
            <i class="fa-solid fa-circle-exclamation me-3 fs-4"></i>
            <div>
                <strong>Lọc dữ liệu:</strong> @ViewBag.ErrorMessage
            </div>
        </div>
    }

    <form method="get" action="/Products" class="row g-3 align-items-end" id="filterForm">
        <div class="col-md-4">
            <label class="fm-label">Tìm kiếm</label>
            <div class="search-input-group">
                <input type="text" name="keyword" id="searchInput" class="fm-input"
                       placeholder="Nhập tên sản phẩm..."
                       value="@ViewBag.Keyword" autocomplete="off" />
                
                <!-- AJAX SEARCH DROPDOWN -->
                <div id="searchDropdown" class="search-dropdown d-none shadow-lg">
                    <div class="search-dropdown-content">
                        <div id="searchLoading" class="text-center py-3 d-none text-muted">
                            <i class="fa-solid fa-spinner fa-spin me-2"></i> Đang tìm...
                        </div>
                        <ul id="searchResults" class="list-unstyled mb-0"></ul>
                        <div id="searchEmpty" class="text-center py-3 d-none text-muted">
                            <i class="fa-regular fa-face-frown mb-2 d-block mx-auto fs-4"></i>
                            Không tìm thấy sản phẩm
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <label class="fm-label">Danh mục</label>
            <select name="categoryId" class="fm-input">
                <option value="">-- Tất cả --</option>
                @foreach (var cat in ViewBag.Categories)
                {
                    bool isSelected = ViewBag.SelectedCategoryId != null && ViewBag.SelectedCategoryId.ToString() == cat.CategoryId.ToString();
                    if (isSelected)
                    {
                        <option value="@cat.CategoryId" selected>@cat.CategoryName</option>
                    }
                    else
                    {
                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 col-6">
            <label class="fm-label">Giá từ (₫)</label>
            <input type="number" name="minPrice" class="fm-input"
                   min="0" placeholder="0"
                   value="@(ViewBag.MinPrice != null ? ((decimal)ViewBag.MinPrice).ToString("G", System.Globalization.CultureInfo.InvariantCulture) : "")" />
        </div>
        <div class="col-md-2 col-6">
            <label class="fm-label">Giá đến (₫)</label>
            <input type="number" name="maxPrice" class="fm-input"
                   min="0" placeholder="Tối đa"
                   value="@(ViewBag.MaxPrice != null ? ((decimal)ViewBag.MaxPrice).ToString("G", System.Globalization.CultureInfo.InvariantCulture) : "")" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn-accent" style="justify-content:center;padding:12px;height:48px;">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </div>
    </form>

    @if (ViewBag.Keyword != null || (ViewBag.SelectedCategoryId != null && (int)ViewBag.SelectedCategoryId > 0) || ViewBag.MinPrice != null || ViewBag.MaxPrice != null)
    {
        <div class="mt-3">
            <span class="text-muted" style="font-size:13px;">
                <i class="fa-solid fa-filter me-1"></i>Tìm thấy <strong>@ViewBag.TotalItems</strong> sản phẩm thỏa mãn điều kiện
            </span>
        </div>
    }
</div>

<!-- CATEGORY QUICK FILTERS -->
<div class="mb-4 stagger-item">
    @{
        // Tạo query string chung cho các filter khác trừ categoryId
        var currentKeyword = ViewBag.Keyword as string;
        var currentMin = (ViewBag.MinPrice != null) ? ((decimal)ViewBag.MinPrice).ToString("G", System.Globalization.CultureInfo.InvariantCulture) : "";
        var currentMax = (ViewBag.MaxPrice != null) ? ((decimal)ViewBag.MaxPrice).ToString("G", System.Globalization.CultureInfo.InvariantCulture) : "";
        var baseQuery = $"keyword={currentKeyword}&minPrice={currentMin}&maxPrice={currentMax}";
    }

    <a href="/Products?@baseQuery" class="filter-pill @(ViewBag.SelectedCategoryId == null || (int)ViewBag.SelectedCategoryId == 0 ? "active" : "")">
        <i class="fa-solid fa-border-all me-1"></i>Tất cả
    </a>
    @foreach (var cat in ViewBag.Categories)
    {
        <a href="/Products?categoryId=@cat.CategoryId&@baseQuery"
           class="filter-pill @(ViewBag.SelectedCategoryId != null && (int)ViewBag.SelectedCategoryId == cat.CategoryId ? "active" : "")">
            @cat.CategoryName
        </a>
    }
</div>

<!-- PRODUCT GRID -->
@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">🔍</div>
        <div class="empty-state-title">Không tìm thấy sản phẩm</div>
        <div class="empty-state-text">Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm.</div>
        <a href="/Products" class="btn-accent">
            <i class="fa-solid fa-arrow-left"></i> Xem tất cả
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6 stagger-item">
                <div class="product-card-premium">
                    <div class="product-card-img-wrap">
                        <a href="/Products/Details/@item.ProductId">
                            <img src="~/uploads/@item.ImagePath"
                                 alt="@item.Name"
                                 onerror="this.onerror=null; this.src='/images/placeholder.svg';" />
                        </a>
                        @if (item.Stock > 0 && item.Stock <= 5)
                        {
                            <span class="product-badge sale">Sắp hết</span>
                        }
                        else if (item.Stock <= 0)
                        {
                            <span class="product-badge out">Hết hàng</span>
                        }
                    </div>
                    <div class="product-card-body">
                        <a href="/Products/Details/@item.ProductId" style="text-decoration:none;color:inherit;">
                            <div class="product-card-title">@item.Name</div>
                        </a>
                        <div class="product-card-desc">@item.Description</div>
                        <div class="mt-2 mb-1">
                            @if (item.Stock > 0)
                            {
                                <div class="text-success small fw-semibold">
                                     Còn @item.Stock sp
                                </div>
                            }
                            else
                            {
                                <div class="text-danger small fw-semibold">
                                     Hết hàng
                                </div>
                            }
                        </div>
                        <div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">@item.Weight</div>
                        <div class="product-card-bottom">
                            <span class="product-price">@item.Price.ToString("N0") ₫</span>
                            <div class="d-flex gap-2">
                                <a href="/Products/Details/@item.ProductId" class="table-action-btn" title="Chi tiết">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <form asp-action="Add" asp-controller="Cart" asp-route-id="@item.ProductId" method="post" class="ajax-cart-form" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-cart" title="Thêm vào giỏ hàng" @(item.Stock <= 0 ? "disabled style=opacity:0.5;cursor:not-allowed;" : "")>
                                        <i class="fa-solid fa-cart-plus"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- PAGINATION -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Product pagination" class="mt-5 d-flex justify-content-center stagger-item">
            <ul class="pagination pagination-modern">
                @{
                    var pQuery = $"keyword={currentKeyword}&categoryId={ViewBag.SelectedCategoryId}&minPrice={currentMin}&maxPrice={currentMax}";
                }
                <!-- PREV -->
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&@pQuery">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>

                <!-- PAGE NUMBERS -->
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == 1 || i == ViewBag.TotalPages || Math.Abs(i - ViewBag.CurrentPage) <= 2)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="?page=@i&@pQuery">@i</a>
                        </li>
                    }
                    else if (Math.Abs(i - ViewBag.CurrentPage) == 3)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                <!-- NEXT -->
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&@pQuery">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
