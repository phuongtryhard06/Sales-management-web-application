@model List<FreshMart.Models.Order>
@Html.AntiForgeryToken()

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    string[] validStatuses = ViewBag.ValidStatuses;
}

<!-- PAGE HEADER -->
<div class="d-flex align-items-center justify-content-between mb-4 stagger-item">
    <h4 class="fw-bold mb-0" style="color:var(--text-primary);">
        <i class="fa-solid fa-receipt me-2" style="color:var(--accent);"></i>Quản lý Đơn hàng
    </h4>
    <span class="text-muted" style="font-size:13px;">
        Tổng: <strong>@ViewBag.TotalItems</strong> đơn hàng
    </span>
</div>

<!-- THỐNG KÊ NHANH -->
<div class="row g-3 mb-4">
    <div class="col-md-4 stagger-item">
        <div class="fm-card" style="border-left: 4px solid #f59e0b;">
            <div class="fm-card-body d-flex align-items-center gap-3">
                <div style="font-size:28px;">⏳</div>
                <div>
                    <div class="fw-bold" style="font-size:22px;">@ViewBag.PendingCount</div>
                    <div class="text-muted" style="font-size:13px;">Chờ xử lý</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 stagger-item">
        <div class="fm-card" style="border-left: 4px solid #22c55e;">
            <div class="fm-card-body d-flex align-items-center gap-3">
                <div style="font-size:28px;">✅</div>
                <div>
                    <div class="fw-bold" style="font-size:22px;">@ViewBag.CompletedCount</div>
                    <div class="text-muted" style="font-size:13px;">Hoàn thành</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 stagger-item">
        <div class="fm-card" style="border-left: 4px solid #ef4444;">
            <div class="fm-card-body d-flex align-items-center gap-3">
                <div style="font-size:28px;">❌</div>
                <div>
                    <div class="fw-bold" style="font-size:22px;">@ViewBag.CancelledCount</div>
                    <div class="text-muted" style="font-size:13px;">Đã hủy</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BỘ LỌC TRẠNG THÁI -->
<div class="mb-3 stagger-item">
    <a href="/AdminOrder" class="filter-pill @(ViewBag.FilterStatus == "" ? "active" : "")">
        <i class="fa-solid fa-border-all me-1"></i>Tất cả
    </a>
    <a href="/AdminOrder?status=Pending" class="filter-pill @(ViewBag.FilterStatus == "Pending" ? "active" : "")">
        ⏳ Chờ xử lý
    </a>
    <a href="/AdminOrder?status=Completed" class="filter-pill @(ViewBag.FilterStatus == "Completed" ? "active" : "")">
        ✅ Hoàn thành
    </a>
    <a href="/AdminOrder?status=Cancelled" class="filter-pill @(ViewBag.FilterStatus == "Cancelled" ? "active" : "")">
        ❌ Đã hủy
    </a>
</div>

<!-- BẢNG ĐƠN HÀNG -->
<div class="fm-card stagger-item">
    <div class="fm-card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-state p-5">
                <div class="empty-state-icon">📋</div>
                <div class="empty-state-title">Chưa có đơn hàng nào</div>
                <div class="empty-state-text">Chưa có đơn hàng nào trong hệ thống.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="fm-table" style="width: 100%; min-width: 1000px;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Khách hàng</th>
                            <th>Email</th>
                            <th>Ngày đặt</th>
                            <th>Thanh toán</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>#@order.OrderId</strong></td>
                                <td>@order.FullName</td>
                                 <td style="font-size:12px;color:var(--text-muted);">@order.Email</td>
                                 <td style="font-size:12px;">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                 <td style="font-size:12px;">
                                     @{
                                         var pmText = order.PaymentMethod switch {
                                             "Cash" => "Tiền mặt (COD)",
                                             "Credit Card" => "Thẻ tín dụng",
                                             "Debit Card" => "Thẻ ghi nợ",
                                             _ => order.PaymentMethod
                                         };
                                     }
                                     @pmText
                                 </td>
                                 <td>
                                     <strong style="color:var(--accent);">@order.TotalAmount.ToString("N0") ₫</strong>
                                 </td>
                                <td>
                                    @{
                                        var badgeClass = order.Status switch {
                                            "Completed" => "badge-status completed",
                                            "Cancelled" => "badge-status cancelled",
                                            _ => "badge-status pending"
                                        };
                                        var badgeText = order.Status switch {
                                            "Completed" => "✅ Hoàn thành",
                                            "Cancelled" => "❌ Đã hủy",
                                            _ => "⏳ Chờ xử lý"
                                        };
                                    }
                                    <span class="@badgeClass">@badgeText</span>
                                </td>
                                 <td>
                                    <a href="/AdminOrder/Details/@order.OrderId" class="table-action-btn" title="Xem chi tiết">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a href="/AdminOrder/Delete/@order.OrderId" 
                                       class="table-action-btn danger ms-1" 
                                       data-confirm-delete 
                                       data-name="đơn hàng #@order.OrderId" 
                                       title="Xóa đơn hàng">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PHÂN TRANG -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="d-flex justify-content-center p-3">
                    <nav>
                        <ul class="pagination pagination-modern">
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&status=@ViewBag.FilterStatus">
                                    <i class="fa-solid fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i&status=@ViewBag.FilterStatus">@i</a>
                                </li>
                            }
                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&status=@ViewBag.FilterStatus">
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- INLINE STYLES CHO BADGE -->
<style>
    .badge-status {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    .badge-status.pending { background: rgba(245,158,11,0.15); color: #d97706; }
    .badge-status.completed { background: rgba(34,197,94,0.15); color: #16a34a; }
    .badge-status.cancelled { background: rgba(239,68,68,0.15); color: #dc2626; }
</style>
