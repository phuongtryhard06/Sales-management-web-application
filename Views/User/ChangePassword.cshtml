@model FreshMart.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<style>
    .password-card {
        max-width: 500px;
        margin: 0 auto;
        background: white;
        border-radius: 1.5rem;
        padding: 40px;
        box-shadow: 0 8px 30px rgba(124, 58, 237, 0.15);
    }

    .password-title {
        font-size: 28px;
        font-weight: 800;
        color: #7C3AED;
        text-align: center;
        margin-bottom: 30px;
    }

    .password-icon {
        text-align: center;
        font-size: 50px;
        margin-bottom: 15px;
    }

    .form-label-custom {
        font-weight: 700;
        color: #374151;
        font-size: 14px;
    }

    .form-control-custom {
        border-radius: 12px;
        padding: 12px 16px;
        border: 2px solid #e5e7eb;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .form-control-custom:focus {
        border-color: #7C3AED;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
    }

    .btn-change-pw {
        width: 100%;
        padding: 12px;
        border-radius: 25px;
        font-weight: 700;
        font-size: 16px;
        background: #7C3AED;
        color: white;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-change-pw:hover {
        background: #6d28d9;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.3);
    }
</style>

<!-- SUCCESS / ERROR MESSAGES -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-pill shadow-sm" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-pill shadow-sm" role="alert">
        ❌ @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="password-card">
    <div class="password-icon">🔐</div>
    <h2 class="password-title">Đổi mật khẩu</h2>

    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()

        <!-- Current Password -->
        <div class="mb-3">
            <label class="form-label-custom">Mật khẩu hiện tại</label>
            <input asp-for="CurrentPassword" type="password" class="form-control form-control-custom" 
                   placeholder="Nhập mật khẩu hiện tại" />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>

        <!-- New Password -->
        <div class="mb-3">
            <label class="form-label-custom">Mật khẩu mới</label>
            <input asp-for="NewPassword" type="password" class="form-control form-control-custom" 
                   placeholder="Nhập mật khẩu mới (ít nhất 6 ký tự)" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <!-- Confirm New Password -->
        <div class="mb-4">
            <label class="form-label-custom">Xác nhận mật khẩu mới</label>
            <input asp-for="ConfirmNewPassword" type="password" class="form-control form-control-custom" 
                   placeholder="Nhập lại mật khẩu mới" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn-change-pw">🔒 Đổi mật khẩu</button>
    </form>

    <div class="text-center mt-3">
        <a href="/User/Profile" class="text-decoration-none" style="color: #7C3AED; font-weight: 600;">
            ← Quay lại hồ sơ
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
