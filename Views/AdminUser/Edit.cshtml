@model FreshMart.Models.User

<div class="row justify-content-center stagger-item">
    <div class="col-md-8">
        <div class="fm-card">
            <div class="fm-card-body">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h4 class="fw-bold mb-0">
                        <i class="fa-solid fa-user-pen me-2 text-success"></i>Chỉnh sửa người dùng
                    </h4>
                    <a href="/AdminUser" class="btn btn-outline-secondary btn-sm ripple">
                        <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
                    </a>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label class="fm-label">Họ tên</label>
                        <input asp-for="FullName" class="fm-input" placeholder="Nhập họ tên đầy đủ..." />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="fm-label">Email</label>
                        <input asp-for="Email" class="fm-input" placeholder="example@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="fm-label">Vai trò</label>
                        <select asp-for="Role" class="fm-input form-select">
                            <option value="Customer">Khách hàng</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-accent btn-sm ripple">
                            <i class="fa-solid fa-save me-1"></i>Lưu thay đổi
                        </button>
                        <a href="/AdminUser" class="btn btn-light btn-sm text-muted">
                            Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
