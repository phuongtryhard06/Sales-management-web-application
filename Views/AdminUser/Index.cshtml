@model IEnumerable<FreshMart.Models.User>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color:var(--text-primary);">
            <i class="fa-solid fa-users me-2" style="color:var(--accent);"></i>Quản lý người dùng
        </h4>
        <p class="text-muted mb-0" style="font-size:13px;">Tổng cộng @Model.Count() người dùng</p>
    </div>
    <a href="/AdminUser/Create" class="btn-accent">
        <i class="fa-solid fa-user-plus"></i> Thêm người dùng
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">👥</div>
        <div class="empty-state-title">Chưa có người dùng</div>
        <div class="empty-state-text">Bấm nút "Thêm người dùng" để bắt đầu.</div>
    </div>
}
else
{
    <div class="fm-table-card">
        <table class="fm-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th style="width:120px;text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td style="color:var(--text-muted);font-size:13px;">#@u.UserId</td>
                        <td class="fw-semibold">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#a78bfa);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;">
                                    @u.FullName?.Substring(0,1).ToUpper()
                                </div>
                                @u.FullName
                            </div>
                        </td>
                        <td style="font-size:14px;">@u.Email</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="badge-status admin">Admin</span>
                            }
                            else
                            {
                                <span class="badge-status customer">Khách hàng</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-controller="AdminUser" asp-action="Edit" asp-route-id="@u.UserId"
                               class="table-action-btn" title="Sửa">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form asp-controller="AdminUser" asp-action="Delete" asp-route-id="@u.UserId" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa @u.FullName?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="table-action-btn danger" title="Xóa">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
