@model List<FreshMart.Models.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color:var(--text-primary);">
            <i class="fa-solid fa-folder me-2" style="color:var(--accent);"></i>Quản lý danh mục
        </h4>
        <p class="text-muted mb-0" style="font-size:13px;">Tổng cộng @Model.Count danh mục</p>
    </div>
    <a href="/AdminCategory/Create" class="btn-accent">
        <i class="fa-solid fa-plus"></i> Thêm danh mục
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">📁</div>
        <div class="empty-state-title">Chưa có danh mục</div>
        <div class="empty-state-text">Bấm nút "Thêm danh mục" để bắt đầu.</div>
    </div>
}
else
{
    <div class="fm-table-card">
        <table class="fm-table">
            <thead>
                <tr>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th style="width:120px;text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.CategoryName</td>
                        <td style="color:var(--text-muted);font-size:14px;">@c.Description</td>
                        <td class="text-center">
                            <a href="/AdminCategory/Edit/@c.CategoryId" class="table-action-btn" title="Sửa">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form asp-controller="AdminCategory" asp-action="Delete" asp-route-id="@c.CategoryId" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục @c.CategoryName?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="table-action-btn danger" title="Xóa">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
