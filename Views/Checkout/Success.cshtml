


@model FreshMart.Models.Order

<div class="d-flex justify-content-center">
    <div class="card shadow-lg border-0 rounded-4 p-5 text-center" style="max-width: 550px;">

        <!-- SUCCESS ICON -->
        <div class="mb-3">
            <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center mx-auto"
                 style="width: 90px; height: 90px;">
                <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
            </div>
        </div>

        <!-- TITLE -->
        <h2 class="fw-bold text-success">Đặt hàng thành công!</h2>
        <p class="text-secondary mt-2">Cảm ơn bạn đã mua sắm. Đơn hàng của bạn đã được xác nhận.</p>

        <hr class="my-4" />

        <!-- ORDER SUMMARY -->
        <div class="text-start px-3">
            <p class="mb-2">
                <strong>Mã đơn hàng:</strong> #@Model.OrderId
            </p>

            <p class="mb-2">
                <strong>Phương thức thanh toán:</strong>
                @{
                    var pmText = Model.PaymentMethod switch {
                        "Cash" => "Tiền mặt (COD)",
                        "Credit Card" => "Thẻ tín dụng",
                        "Debit Card" => "Thẻ ghi nợ",
                        _ => Model.PaymentMethod
                    };
                }
                @pmText
            </p>

            <p class="mb-2">
                <strong>Tổng thanh toán:</strong>
                <span class="fw-bold text-success">@Model.TotalAmount.ToString("N0") ₫</span>
            </p>

            <p class="mb-0 text-secondary">
                Bạn có thể theo dõi đơn hàng này tại trang <strong>Đơn hàng của tôi</strong>.
            </p>
        </div>

        <!-- BUTTONS -->
        <div class="mt-4">
            <a href="/Checkout/MyOrders" class="btn btn-outline-success rounded-pill px-4 py-2 me-2">
                Xem đơn hàng
            </a>

            <a href="/" class="btn btn-success rounded-pill px-4 py-2">
                Tiếp tục mua sắm →
            </a>
        </div>
        <div class="mt-3">
            <a href="@Url.Action("Receipt", "Checkout", new { id = Model.OrderId })"
               class="btn btn-success w-100 rounded-pill py-2" target="_blank">
                Tải hóa đơn (PDF)
            </a>
        </div>



    </div>

</div>

<!-- ICON LIBRARY (only if not loaded globally) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    .card {
        border-radius: 1.2rem !important;
    }
</style>
