@model FreshMart.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    List<FreshMart.Models.Product> products = ViewBag.Products as List<FreshMart.Models.Product>;
    var userRole = Context.Session.GetString("UserRole");

    var badgeClass = Model.Status switch
    {
        "Completed" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-warning text-dark"
    };
    var statusText = Model.Status switch
    {
        "Completed" => "✔ Hoàn thành",
        "Cancelled" => "✕ Đã hủy",
        _ => "⏳ Đang chờ"
    };
}

<!-- SUCCESS/ERROR -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-pill shadow-sm" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-pill shadow-sm" role="alert">
        ❌ @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h2 class="fw-bold mb-4" style="color: #7C3AED;">📋 Chi tiết đơn hàng</h2>

<!-- ORDER HEADER -->
<div class="card shadow-sm border-0 rounded-4 mb-4 p-4">
    <div class="d-flex justify-content-between flex-wrap">
        <div>
            <h4 class="fw-bold mb-1">Đơn hàng #@Model.OrderId</h4>
            <p class="mb-1 text-secondary">
                <strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
            </p>
            <p class="mb-1 text-secondary">
                <strong>Thanh toán:</strong>
                @{
                    var pmText = Model.PaymentMethod switch {
                        "Cash" => "Tiền mặt (COD)",
                        "Credit Card" => "Thẻ tín dụng",
                        "Debit Card" => "Thẻ ghi nợ",
                        _ => Model.PaymentMethod
                    };
                }
                @pmText
            </p>
            <p class="mb-0 text-secondary">
                <strong>Tổng tiền:</strong>
                <span class="fw-bold" style="color: #7C3AED; font-size: 1.2rem;">@Model.TotalAmount.ToString("N0") ₫</span>
            </p>
        </div>

        <div class="align-self-start">
            <span class="badge @badgeClass px-4 py-2 rounded-pill fs-6 shadow-sm">
                @statusText
            </span>
        </div>
    </div>

    <!-- CANCEL/UPDATE ACTIONS -->
    <div class="mt-3 d-flex gap-2 flex-wrap">
        @if (Model.Status == "Pending")
        {
            <form asp-action="CancelOrder" asp-route-id="@Model.OrderId" method="post" 
                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                    ✕ Hủy đơn hàng
                </button>
            </form>
        }

        @if (userRole == "Admin")
        {
            <div class="dropdown">
                <button class="btn btn-outline-primary btn-sm rounded-pill px-3 dropdown-toggle" 
                        type="button" data-bs-toggle="dropdown" style="border-color: #7C3AED; color: #7C3AED;">
                    🔄 Cập nhật trạng thái
                </button>
                <ul class="dropdown-menu shadow border-0">
                    <li>
                        <form asp-action="UpdateStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.OrderId" />
                            <input type="hidden" name="status" value="Pending" />
                            <button type="submit" class="dropdown-item">⏳ Đang chờ</button>
                        </form>
                    </li>
                    <li>
                        <form asp-action="UpdateStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.OrderId" />
                            <input type="hidden" name="status" value="Completed" />
                            <button type="submit" class="dropdown-item">✔ Hoàn thành</button>
                        </form>
                    </li>
                    <li>
                        <form asp-action="UpdateStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.OrderId" />
                            <input type="hidden" name="status" value="Cancelled" />
                            <button type="submit" class="dropdown-item text-danger">✕ Đã hủy</button>
                        </form>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

<!-- ITEMS LIST -->
<div class="card shadow-sm border-0 rounded-4 p-4">
    <h5 class="fw-bold mb-3 text-secondary">🛍️ Sản phẩm trong đơn hàng</h5>

    <table class="table table-borderless align-middle">
        <thead>
            <tr class="text-secondary small">
                <th style="width:70px;">Ảnh</th>
                <th>Sản phẩm</th>
                <th class="text-center">SL</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in ViewBag.Items)
            {
                var product = products?.FirstOrDefault(p => p.ProductId == item.ProductId);

                <tr class="order-row">
                    <td>
                        <img src="~/uploads/@product?.ImagePath"
                             class="shadow-sm"
                             style="height:60px;width:60px;object-fit:cover;border-radius:12px;"
                             onerror="this.onerror=null; this.src='/images/placeholder.svg';" />
                    </td>
                    <td class="fw-semibold">@product?.Name</td>
                    <td class="text-center fw-bold">@item.Quantity</td>
                    <td class="text-end">@item.Price.ToString("N0") ₫</td>
                    <td class="text-end fw-bold" style="color: #7C3AED;">
                        @((item.Price * item.Quantity).ToString("N0")) ₫
                    </td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <td colspan="4" class="text-end fw-bold fs-5">Tổng cộng:</td>
                <td class="text-end fw-bold fs-5" style="color: #7C3AED;">
                    @Model.TotalAmount.ToString("N0") ₫
                </td>
            </tr>
        </tfoot>
    </table>
</div>

<div class="mt-4">
    <a href="/Checkout/MyOrders" class="btn btn-secondary px-4 py-2 rounded-pill">
        ← Quay lại danh sách
    </a>
</div>

<style>
    .order-row:hover {
        background-color: #f5f3ff;
        transition: 0.25s ease;
    }

    .card {
        border-radius: 1rem !important;
    }
</style>
