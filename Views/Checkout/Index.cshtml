@model FreshMart.Models.CheckoutViewModel

@{
	ViewData["Title"] = "Thanh toán";
}

<!-- =======================
   CHECKOUT PAGE STYLES
======================== -->
<style>

	body {
		background: linear-gradient(135deg, #f7f9fc 0%, #edf1f5 100%);
		font-family: "Inter", sans-serif;
	}

	h2.checkout-title {
		font-size: 44px;
		font-weight: 900;
		background: linear-gradient(to right, #067a47, #1fbf7a);
		-webkit-background-clip: text;
		color: transparent;
		margin-bottom: 30px;
		letter-spacing: -1px;
	}

	.checkout-card {
		background: rgba(255, 255, 255, 0.65);
		backdrop-filter: blur(18px);
		border-radius: 24px;
		padding: 35px;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08), 0 8px 20px rgba(3, 143, 73, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.45);
		animation: fadeUp 0.6s ease-out;
	}

	.order-summary {
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(14px);
		border-radius: 24px;
		padding: 30px;
		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.10), 0 6px 15px rgba(2, 100, 55, 0.10);
		border: 1px solid rgba(255, 255, 255, 0.55);
		position: sticky;
		top: 20px;
		animation: fadeRight 0.7s ease;
	}

	@@keyframes fadeUp {
		from

	{
		opacity: 0;
		transform: translateY(25px);
	}

	to {
		opacity: 1;
		transform: translateY(0);
	}

	}

	@@keyframes fadeRight {
		from

	{
		opacity: 0;
		transform: translateX(35px);
	}

	to {
		opacity: 1;
		transform: translateX(0);
	}

	}

	.form-label-standard {
		display: block;
		font-size: 14px;
		font-weight: 600;
		color: #067a47;
		margin-bottom: 8px;
		margin-left: 4px;
	}

	.form-floating-label {
		position: relative;
		margin-bottom: 20px;
	}

		.form-floating-label input,
		.form-floating-label textarea,
		.form-floating-label select {
			width: 100%;
			padding: 16px 14px;
			font-size: 15px;
			border-radius: 16px;
			border: 2px solid #d9d9d9;
			background: #ffffffd9;
			transition: all 0.25s ease;
		}

			.form-floating-label input:focus,
			.form-floating-label textarea:focus,
			.form-floating-label select:focus {
				border-color: #14a86a;
				box-shadow: 0 0 0 4px rgba(20,168,106,0.25);
				background: white;
			}

		.form-floating-label label {
			position: absolute;
			top: 50%;
			left: 16px;
			transform: translateY(-50%);
			font-size: 14px;
			color: #7b7b7b;
			transition: 0.25s ease;
			background: white;
			padding: 0 4px;
			pointer-events: none;
		}

		.form-floating-label input:focus + label,
		.form-floating-label input:not(:placeholder-shown) + label,
		.form-floating-label textarea:focus + label,
		.form-floating-label textarea:not(:placeholder-shown) + label {
			top: -8px;
			font-size: 12px;
			color: #067a47;
			transform: translateY(0);
		}

	.checkout-btn {
		background: linear-gradient(135deg, #0f8f56 0%, #067a47 100%);
		border: none;
		padding: 16px;
		font-size: 18px;
		font-weight: 700;
		border-radius: 16px;
		color: white;
		width: 100%;
		transition: 0.25s ease;
		box-shadow: 0 10px 25px rgba(11, 138, 73, 0.25);
	}

		.checkout-btn:hover {
			transform: translateY(-4px);
			box-shadow: 0 14px 32px rgba(7, 109, 60, 0.35);
		}

	.text-danger {
		font-size: 13px;
		margin-top: 5px;
		display: block;
	}

</style>

<h2 class="checkout-title">Thanh toán</h2>

<div class="row g-4">

	<!-- LEFT: FORM -->
	<div class="col-lg-7">
		<div class="checkout-card">

			<form asp-action="PlaceOrder" asp-controller="Checkout" method="post" novalidate>
				@Html.AntiForgeryToken()
				<input asp-for="UserId" type="hidden" />

				<div class="form-floating-label">
					<input asp-for="FullName" placeholder=" " />
					<label asp-for="FullName"></label>
					<span asp-validation-for="FullName" class="text-danger"></span>
				</div>

				<div class="form-floating-label">
					<input asp-for="Email" placeholder=" " />
					<label asp-for="Email"></label>
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>

				<div class="form-floating-label">
					<textarea asp-for="Address" rows="3" placeholder=" "></textarea>
					<label asp-for="Address"></label>
					<span asp-validation-for="Address" class="text-danger"></span>
				</div>

				<div class="form-floating-label">
					<input asp-for="Phone" placeholder=" " />
					<label asp-for="Phone"></label>
					<span asp-validation-for="Phone" class="text-danger"></span>
				</div>

				<div class="form-floating-label">
					<input asp-for="PostalCode" placeholder=" " />
					<label asp-for="PostalCode"></label>
					<span asp-validation-for="PostalCode" class="text-danger"></span>
				</div>

				<div class="mb-4">
					<label asp-for="PaymentMethod" class="form-label-standard"></label>
					<div class="form-floating-label" style="margin-bottom:0;">
						<select asp-for="PaymentMethod" id="paymentMethod">
							<option value="">Chọn phương thức</option>
							<option value="Cash">Tiền mặt (COD)</option>
							<option value="Credit Card">Thẻ tín dụng</option>
							<option value="Debit Card">Thẻ ghi nợ</option>
						</select>
					</div>
					<span asp-validation-for="PaymentMethod" class="text-danger"></span>
				</div>

				<!-- CARD DETAILS -->
				<div id="cardSection" style="display:none;">
					<div class="form-floating-label">
						<input asp-for="CardNumber" placeholder=" " />
						<label asp-for="CardNumber"></label>
						<span asp-validation-for="CardNumber" class="text-danger"></span>
					</div>

					<div class="form-floating-label">
						<input asp-for="Expiry" placeholder="MM/YY" />
						<label asp-for="Expiry"></label>
						<span asp-validation-for="Expiry" class="text-danger"></span>
					</div>

					<div class="form-floating-label">
						<input asp-for="CVV" placeholder=" " />
						<label asp-for="CVV"></label>
						<span asp-validation-for="CVV" class="text-danger"></span>
					</div>
				</div>

				<button type="submit" class="checkout-btn mt-3">
					Đặt hàng →
				</button>
			</form>
		</div>
	</div>

	<!-- RIGHT SIDE -->
	<div class="col-lg-5">
		<!-- ORDER SUMMARY -->
		<div class="order-summary card border-0 shadow-sm rounded-4 p-4">

			<h5 class="fw-bold mb-3 text-secondary">Tóm tắt Đơn hàng</h5>

			<div class="summary-items">
				@foreach (var item in ViewBag.Cart)
				{
					<div class="summary-row d-flex align-items-center justify-content-between mb-3 p-2 rounded-3">

						<!-- Image + Name -->
						<div class="d-flex align-items-center gap-3">
							<img src="~/uploads/@item.ImagePath"
								 class="summary-img" />

							<div>
								<div class="fw-semibold">@item.ProductName</div>
								<div class="text-muted small">SL: @item.Quantity</div>
							</div>
						</div>

						<!-- Price -->
						<div class="text-end">
							<div class="fw-bold text-success">@((item.Price * item.Quantity).ToString("N0")) ₫</div>
							<div class="text-muted small">(@item.Price.ToString("N0") ₫ / SP)</div>
						</div>

					</div>
				}
			</div>

			<hr />

			<div class="d-flex justify-content-between align-items-center">
				<h4 class="fw-bold text-success m-0">Tổng:</h4>
				<h3 class="fw-bold text-success m-0">@ViewBag.CartTotal.ToString("N0") ₫</h3>
			</div>

		</div>


	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />

	<script>
		const payment = document.getElementById("paymentMethod");
		const cardSection = document.getElementById("cardSection");

		function toggleCard() {
			cardSection.style.display =
				(payment.value === "Credit Card" || payment.value === "Debit Card")
					? "block"
					: "none";
		}

		payment.addEventListener("change", toggleCard);
		toggleCard();
	</script>
}